    (uuid "663e0970-815a-482b-99a9-a67596dff2d2")
  )
  (text "   /Y2 (90H-96H) : U14 8253A    (100Hz -> 1.000Hz IR1; 2.0kHz Buzzer)" (exclude_from_sim no) (at 944.88 134.62 0)
