    (effects (font (size 1.52 1.52)) (justify left))
    (uuid "37f96eff-3207-488d-ba5b-10d1bcbf3e57")
  )
  (text "2. ISOLATED I/O PORT MAP (U9 74LS138, M/IO = 0, A7=1, A6=0):" (exclude_from_sim no) (at 944.88 96.52 0)
    (effects (font (size 1.78 1.78) bold) (justify left))
    (uuid "1e589fe8-078f-4bf6-ad16-00f65dd93e0c")
  )
  (text "   /Y0 (80H-86H) : U10 8255A #1 (Keypad, 20x4 LCD, Buzzer, Global LEDs)" (exclude_from_sim no) (at 944.88 109.22 0)
